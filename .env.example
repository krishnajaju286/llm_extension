# Adaptive LLM Router - Environment Configuration
# Research Prototype (Simulation Mode Active by Default)

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Telemetry Database
ROUTER_DB_PATH=./backend/router_telemetry.db

# External LLM Providers (Optional - Not required for prototype simulation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AWS_BEDROCK_REGION=
OLLAMA_HOST_ENDPOINT=http://localhost:11434

# Prototype Simulation Flags
SIMULATION_MODE=True
ENABLE_SYNTHETIC_WORKLOAD_INFLATION=True
